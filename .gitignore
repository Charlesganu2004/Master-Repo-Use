__pycache__/
*.py[cod]
.venv/
venv/
env/
.env
.env.*
*.log
.DS_Store
_site/

# Generated layout chooser. Temporary: delete once a layout is picked.
layout-options.html

# codex-token-reducer keeps its SQLite caches here. They are regenerable, they
# are specific to one machine, and index.db alone is 31 MB. The reducer itself
# is untouched; only its cache is untracked, and the files stay on disk.
.codex-token-reducer/

# Prompt text saved to a file by accident. These are scratch, not repository
# content, and one reached a commit on 2026-09-09.
/finish all of this*.txt

# Runtime goal state. Captured from the first task of each session, so it
# changes constantly; docs/auto-mode-goal.json is the committed seed.
.auto-mode/

# Build-time copies staged into the package by setup.py. The repository keeps
# one copy of each module and skill; these are produced by a build and must not
# be committed, or the duplication this design avoids comes back through the
# back door.
master_harness/_skills/
master_harness/_data/
master_harness/skill_pipeline.py
master_harness/auto_mode_harness.py
master_harness/harness_*.py
master_harness/install_auto_mode.py
master_harness/capability_definitions.py
master_harness/sync_project_skills.py
build/
dist/*.whl
dist/*.tar.gz
*.egg-info/
master_harness/harness_paths.py
master_harness/_agents/
master_harness/no_prune_guard.py
master_harness/no_compress_guard.py
master_harness/verify_auto_mode.py

# Backups the installer writes before touching a client config. Safety copies,
# not content: the file beside them is the tracked one.
*.json.bak

# A pip cache landing in the repository root. pip resolves its cache relative to
# the working directory when HOME is overridden, which the packaging test does,
# and 1.1 MB of it appeared here untracked. The test now pins PIP_CACHE_DIR; this
# is the second line of defence, because the failure was silent both times.
/pip/
.pip-cache/
master_harness/super_chain.py

# Raw benchmark sessions contain local machine paths. Export reviewed, sanitized
# reports explicitly; keep the original downloadable archive in session artifacts.
/benchmarks/private-benchmark-report.zip

# graphify writes a graph of the repo here; generated, large, and rebuilt in seconds
graphify-out/

# graphify writes this per machine and it holds an absolute local path to the shim
.gemini/settings.json
